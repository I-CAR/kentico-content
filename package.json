{
  "name": "icar-content-kentico-info",
  "private": true,
  "scripts": {
    "prepare": "simple-git-hooks",
    "clean": "rm -f css/style.css css/style.css.map css/style-cms.css.map css/style-cms-swiper.css.map js/script.js js/script.js.map",
    "watch": "concurrently -n pages,cms \"npm:watch:pages\" \"npm:watch:cms\"",
    "dev": "concurrently -n pages,css,js,cms \"npm:watch:pages\" \"npm:watch:css\" \"npm:watch:js\" \"npm:watch:cms\"",
    "watch:pages": "node scripts/build-pages.mjs --watch",
    "generate:templates": "node scripts/generate-templates.mjs",
    "backfill:templates": "node scripts/backfill-templates.mjs",
    "watch:css": "node scripts/build-style-v3.mjs --watch",
    "watch:js": "node scripts/build-js.mjs --watch",
    "watch:cms": "node scripts/build-cms-inline.mjs --watch",
    "build": "npm run build:pages && npm run build:css && npm run build:js:prod && npm run build:cms",
    "build:pages": "node scripts/build-pages.mjs",
    "build:css": "node scripts/build-style-v3.mjs --production",
    "build:js:dev": "node scripts/build-js.mjs",
    "build:js:prod": "node scripts/build-js.mjs --production",
    "build:cms": "node scripts/build-cms-inline.mjs --production",
    "build:cms:dev": "node scripts/build-cms-inline.mjs",
    "build:css:dev": "node scripts/build-style-v3.mjs",
    "vendor:cms-css": "curl -L \"https://info.i-car.com/dist/styles/main.css?v=202106042\" -o css/vendor/cms-main-202106042.css",
    "split:cms-css": "node scripts/split-cms-css.mjs css/vendor/cms-main-202106042.css css/vendor/bootstrap-4.6.0.css css/vendor/cms-main-custom-202106042.css",
    "check:cms-css-links": "node scripts/localize-cms-css-links.mjs",
    "localize:cms-css-links": "node scripts/localize-cms-css-links.mjs --write",
    "check:cms-css-links:split": "node scripts/localize-cms-css-links.mjs --split",
    "localize:cms-css-links:split": "node scripts/localize-cms-css-links.mjs --split --write",
    "audit:cms:legacy": "node scripts/compare-css-selectors.mjs css/vendor/cms-main-202106042.css css/legacy/style-legacy.css",
    "audit:cms": "node scripts/compare-css-selectors.mjs css/vendor/cms-main-202106042.css css/style.css",
    "build:check": "npm run lint:scss && npm run build",
    "lint:scss": "stylelint \"css/scss/**/*.scss\"",
    "format:scss": "prettier --write \"css/scss/**/*.scss\""
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint:scss"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.9",
    "esbuild": "^0.25.9",
    "postcss": "^8.5.16",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "sass": "^1.101.0",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "jquery": "^3.7.1",
    "swiper": "^12.2.0"
  }
}
