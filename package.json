{
  "name": "icar-content-kentico-info",
  "private": true,
  "scripts": {
    "prepare": "simple-git-hooks",
    "clean": "rm -f css/style-v3.css css/style-v3.css.map js/script-v2.js js/script-v2.js.map js/script.js js/script.js.map",
    "start": "concurrently -n css,js \"npm:watch:css\" \"npm:watch:js\"",
    "watch:css": "node scripts/build-style-v3.mjs --watch",
    "watch:js": "node scripts/build-js.mjs --watch",
    "build": "npm run build:css && npm run build:js:prod",
    "build:css": "node scripts/build-style-v3.mjs --production",
    "build:js": "npm run build:js:dev",
    "build:js:dev": "node scripts/build-js.mjs",
    "build:js:prod": "node scripts/build-js.mjs --production",
    "build:dev": "npm run build:css:dev && npm run build:js",
    "build:css:dev": "node scripts/build-style-v3.mjs",
    "build:style-v3-scss": "npm run build:css:dev",
    "build:check": "npm run lint:scss && npm run build",
    "lint:scss": "stylelint \"css/scss/**/*.scss\"",
    "format:scss": "prettier --write \"css/scss/**/*.scss\""
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint:scss"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.9",
    "esbuild": "^0.25.9",
    "postcss": "^8.5.16",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "sass": "^1.101.0",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "jquery": "^3.7.1",
    "swiper": "^12.2.0"
  }
}
