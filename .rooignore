# Dependencies & Package Managers
node_modules/
.pnpm-store/
.npm/
.nvm/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build Caches & Legacy Backups (Active cms/ and previews/ kept readable for verification)
.cache/
.sass-cache/
*.tsbuildinfo
previews-old/
cms-backup/

# CSS Source Maps & Minified Bundles
dev/assets/css/*.css.map
*.min.css.map

# OS & Environment System Files
.DS_Store
Thumbs.db
.env
.env.*
!.env.example

# Git & IDE Internals
.git/
.gitignore
.vscode/*
!.vscode/settings.json
.idea/

# Binaries & Media Assets (Prevents context token bloat)
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.pdf
*.zip
*.tar.gz
*.ico
*.ttf
*.woff
*.woff2

# Execution & Debug Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*