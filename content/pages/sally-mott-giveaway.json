      "<script src=\"https://www.google.com/recaptcha/api.js\" async defer></script>",
      "<script>document.addEventListener(\"DOMContentLoaded\",()=>{const form=document.querySelector(\".ic-form\");if(!form)return;const formCard=form.closest(\".card-body\")||form;const submitBtn=form.querySelector('[type=\"submit\"]');const captchaSettings=form.querySelector('input[name=\"captcha_settings\"]');const recaptchaContainer=form.querySelector(\".g-recaptcha\");const retURL=form.querySelector('input[name=\"retURL\"]')?.value||\"/\";const isLocal=[\"localhost\",\"127.0.0.1\"].includes(location.hostname);const setInvalid=(el,msg)=>{if(!el)return;el.classList.add(\"is-invalid\");el.setAttribute(\"aria-invalid\",\"true\");let fb=el.parentElement?.querySelector(\".invalid-feedback\");if(!fb){fb=document.createElement(\"div\");fb.className=\"invalid-feedback\";el.parentElement?.appendChild(fb);}fb.textContent=msg||\"Please correct this field.\";};const clearInvalid=el=>{if(!el)return;el.classList.remove(\"is-invalid\");el.removeAttribute(\"aria-invalid\");const fb=el.parentElement?.querySelector(\".invalid-feedback\");if(fb)fb.textContent=\"\";};const setRecaptchaInvalid=msg=>{if(!recaptchaContainer)return;let fb=recaptchaContainer.nextElementSibling;if(!fb||!fb.classList||!fb.classList.contains(\"invalid-feedback\")){fb=document.createElement(\"div\");fb.className=\"invalid-feedback d-block mt-2\";recaptchaContainer.insertAdjacentElement(\"afterend\",fb);}fb.textContent=msg||\"Please complete the reCAPTCHA.\";recaptchaContainer.classList.add(\"border\",\"border-danger\",\"rounded\");};const clearRecaptchaInvalid=()=>{if(!recaptchaContainer)return;const fb=recaptchaContainer.nextElementSibling;if(fb&&fb.classList.contains(\"invalid-feedback\"))fb.textContent=\"\";recaptchaContainer.classList.remove(\"border\",\"border-danger\",\"rounded\");};const showSuccessUI=({willRedirect,delaySeconds=15,url=\"https://www.collisioncareers.com/\",isLocal=false})=>{formCard.innerHTML=`<div class=\"ic-message ic-message-success\"><h2 class=\"mb-3\">Thank you!</h2><p class=\"mb-4\">Your entry was successfully submitted. Winner will be randomly selected on <strong>October 20th</strong> and contacted via email. Good luck!</p><p class=\"mb-0 js-redirect-line\">You will be redirected to <a href=\"${url}\" title=\"Return to homepage\">${url}</a> in <span class=\"js-seconds\">${delaySeconds}</span> second${delaySeconds===1?\"\":\"s\"}…</p></div>`;if(!willRedirect)return;let secs=delaySeconds;const tick=setInterval(()=>{secs-=1;const lineEl=formCard.querySelector(\".js-redirect-line\");if(lineEl){lineEl.innerHTML=`You will be redirected to <a href=\"${url}\" title=\"Return to homepage\">${url}</a> in <span class=\"js-seconds\">${secs}</span> second${secs===1?\"\":\"s\"}.`; }if(secs<=0){clearInterval(tick);isLocal?window.open(url,\"_blank\"):window.location.href=url;}},1000);};const validateForm=()=>{let isValid=true;form.querySelectorAll(\".is-invalid\").forEach(clearInvalid);clearRecaptchaInvalid();form.querySelectorAll(\"[required]\").forEach(field=>{if(!field.value||!field.value.trim()){setInvalid(field,\"This field is required.\");isValid=false;}});const emailField=form.querySelector(\"#email\");if(emailField&&emailField.value.trim()){const emailRegex=/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;if(!emailRegex.test(emailField.value)){setInvalid(emailField,\"Enter a valid email address.\");isValid=false;}}const phoneField=form.querySelector(\"#phone\");if(phoneField&&phoneField.value.trim()){const phoneRegex=/^[0-9]+$/;if(!phoneRegex.test(phoneField.value)){setInvalid(phoneField,\"Use numbers only (no dashes or spaces).\");isValid=false;}}if(!isLocal){let recaptchaOK=false;try{recaptchaOK=typeof grecaptcha!==\"undefined\"&&grecaptcha.getResponse().length>0;}catch(_){recaptchaOK=false;}if(!recaptchaOK){setRecaptchaInvalid(\"Please verify you are not a robot.\");isValid=false;}}return isValid;};form.addEventListener(\"submit\",e=>{e.preventDefault();if(!validateForm())return;submitBtn?.setAttribute(\"disabled\",\"disabled\");if(submitBtn)submitBtn.textContent=\"Submitting…\";if(isLocal){showSuccessUI({willRedirect:true,delaySeconds:15,url:retURL,isLocal:true});try{grecaptcha?.reset?.();}catch(_){}return;}try{const cs=captchaSettings?.value?JSON.parse(captchaSettings.value):{};cs.ts=String(Date.now());if(captchaSettings)captchaSettings.value=JSON.stringify(cs);}catch(_){}let iframe=document.querySelector('iframe[name=\"sfw2l_iframe\"]');if(!iframe){iframe=document.createElement(\"iframe\");iframe.name=\"sfw2l_iframe\";iframe.style.display=\"none\";document.body.appendChild(iframe);}iframe.addEventListener(\"load\",()=>{showSuccessUI({willRedirect:true,delaySeconds:15,url:retURL,isLocal:false});try{grecaptcha?.reset?.();}catch(_){}submitBtn?.removeAttribute(\"disabled\");if(submitBtn)submitBtn.textContent=\"Enter Giveaway\";},{once:true});const prevTarget=form.getAttribute(\"target\");form.setAttribute(\"target\",\"sfw2l_iframe\");form.submit();if(prevTarget===null)form.removeAttribute(\"target\");else form.setAttribute(\"target\",prevTarget);});});</script>"
