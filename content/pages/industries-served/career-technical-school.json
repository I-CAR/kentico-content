    {
      "type": "textMedia",
      "id": "pdp-ee",
      "title": "Professional Development Program - Education Edition (PDP-EE)",
      "backgroundLight": true,
      "body": [
        "I-CAR PDP-EE program was developed to equip Career and Technical Education schools and educators with collision repair curriculum for their students. As vehicle technology and repair processes advanced, our entry-level curriculum has evolved to keep pace, ensuring technicians are equipped with the latest skills and knowledge. I-CAR Academy for schools will completely replace PDP-EE by 2027."
      ],
      "bodyHtml": [
        "For detailed transition timelines and milestones, please e-mail <a href=\"mailto:academy.schools@i-car.com\">academy.schools@i-car.com</a>."
      ],
      "buttons": [
        {
          "label": "View PDP-EE",
